{
  "manifest_version": 3,
  "name": "VaultForge",
  "version": "0.1.0",
  "description": "Fill and save logins from VaultForge, the password manager by Forge Studio.",
  "key": "",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "VaultForge",
    "default_popup": "src/popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "background": { "service_worker": "src/background.js", "type": "module" },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["src/content.js"], "run_at": "document_idle", "all_frames": true }
  ],
  "permissions": ["nativeMessaging", "storage", "tabs"],
  "commands": {
    "fill-login": {
      "suggested_key": { "default": "Ctrl+Shift+L" },
      "description": "Fill the login for this page"
    }
  }
}
