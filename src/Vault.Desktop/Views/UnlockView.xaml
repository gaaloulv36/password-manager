<UserControl x:Class="Vault.Desktop.Views.UnlockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border Style="{StaticResource Card}" Width="420" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
                <TextBlock Text="🔒" FontSize="40" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding VaultName}" Style="{StaticResource TitleTextBlockStyle}"
                           HorizontalAlignment="Center" Margin="0,8,0,2" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding VaultPath}" ToolTip="{Binding VaultPath}" Style="{StaticResource CaptionTextBlockStyle}"
                           HorizontalAlignment="Center" Opacity="0.6" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />

                <TextBlock Text="Master password" Style="{StaticResource FieldLabel}" Margin="0,24,0,4" />
                <PasswordBox x:Name="PasswordInput" PasswordChanged="OnPasswordChanged"
                             IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}" />

                <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}"
                           Visibility="{Binding Error, Converter={StaticResource VisibleWhenSet}}" />

                <Button Command="{Binding UnlockCommand}" AutomationProperties.Name="Unlock" IsDefault="True" Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Stretch" Padding="12,8" Margin="0,16,0,0">
                    <Grid>
                        <TextBlock Text="Unlock" Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVisibility}}" />
                        <TextBlock Text="Unlocking…" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Button>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <Button Content="Open another vault" Command="{Binding OpenOtherVaultCommand}" Margin="0,0,8,0" />
                    <Button Content="Create new vault" Command="{Binding CreateVaultCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
