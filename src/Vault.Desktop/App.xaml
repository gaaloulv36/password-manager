<Application x:Class="Vault.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Vault.Desktop.ViewModels"
             xmlns:views="clr-namespace:Vault.Desktop.Views"
             xmlns:conv="clr-namespace:Vault.Desktop.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Windows 11 Fluent look; follows the system light/dark setting -->
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
            <conv:NullToVisibilityConverter x:Key="VisibleWhenSet" />
            <conv:NullToVisibilityConverter x:Key="VisibleWhenNull" Invert="True" />
            <conv:InverseBoolConverter x:Key="InverseBool" />

            <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

            <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Opacity" Value="0.75" />
                <Setter Property="Margin" Value="0,14,0,4" />
            </Style>

            <Style x:Key="ErrorText" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="#D13438" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,12,0,0" />
            </Style>

            <!-- Card surface used for forms and the details pane -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="24" />
            </Style>

            <DataTemplate DataType="{x:Type vm:WelcomeViewModel}"><views:WelcomeView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:UnlockViewModel}"><views:UnlockView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:CreateVaultViewModel}"><views:CreateVaultView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:VaultViewModel}"><views:VaultView /></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
