<UserControl x:Class="VaultForge.Desktop.Views.CreateVaultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Style="{StaticResource Card}" Width="500" Margin="0,24" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Create a new vault" Style="{StaticResource TitleTextBlockStyle}" />

                <TextBlock Text="Vault file" Style="{StaticResource FieldLabel}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding VaultPath, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseCommand}" Margin="8,0,0,0" />
                </Grid>
                <TextBlock Text="Put it in OneDrive (or another synced folder) to use it on several PCs."
                           Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.65" Margin="0,4,0,0" TextWrapping="Wrap" />

                <TextBlock Text="Master password" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="PasswordInput" PasswordChanged="OnPasswordChanged" />
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar Minimum="0" Maximum="5" Value="{Binding StrengthValue, Mode=OneWay}" Height="4" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding StrengthText}" Style="{StaticResource CaptionTextBlockStyle}"
                               Margin="8,0,0,0" MinWidth="60" />
                </Grid>

                <TextBlock Text="Confirm master password" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="ConfirmInput" PasswordChanged="OnConfirmChanged" />

                <Button Content="Suggest a passphrase…" Command="{Binding SuggestPassphraseCommand}"
                        HorizontalAlignment="Left" Margin="0,12,0,0" />
                <Border Visibility="{Binding SuggestedPassphrase, Converter={StaticResource VisibleWhenSet}}"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="12,8" Margin="0,8,0,0">
                    <StackPanel>
                        <TextBox Text="{Binding SuggestedPassphrase, Mode=OneWay}" IsReadOnly="True"
                                 FontFamily="{StaticResource MonoFont}" FontSize="15" />
                        <TextBlock Text="Type it into both fields above. Typing it yourself helps you remember it."
                                   Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border BorderBrush="{StaticResource EmberBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,20,0,0">
                    <CheckBox IsChecked="{Binding UnderstandsNoRecovery}">
                        <TextBlock TextWrapping="Wrap"
                                   Text="I understand that if I forget my master password, my vault cannot be recovered by anyone." />
                    </CheckBox>
                </Border>

                <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}"
                           Visibility="{Binding Error, Converter={StaticResource VisibleWhenSet}}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,8,0" Padding="16,6" />
                    <Button Command="{Binding CreateCommand}" AutomationProperties.Name="Create vault" IsDefault="True" Style="{StaticResource AccentButtonStyle}" Padding="16,6">
                        <Grid>
                            <TextBlock Text="Create vault" Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVisibility}}" />
                            <TextBlock Text="Creating…" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
