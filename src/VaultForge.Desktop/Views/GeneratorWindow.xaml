<Window x:Class="VaultForge.Desktop.Views.GeneratorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/VaultForge;component/Assets/VaultForge.ico"
        FontFamily="{StaticResource BodyFont}"
        Background="{StaticResource CharcoalBrush}"
        Title="Password generator · VaultForge"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="24">
        <!-- Result -->
        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="12">
            <DockPanel>
                <Button DockPanel.Dock="Right" AutomationProperties.Name="Regenerate" Content="↻" Command="{Binding RegenerateCommand}" ToolTip="Generate another"
                        FontSize="16" VerticalAlignment="Center" />
                <TextBox Text="{Binding Result, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource MonoFont}" FontSize="16"
                         TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Margin="0,0,8,0" />
            </DockPanel>
        </Border>
        <TextBlock Text="{Binding EntropyText}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.65" Margin="2,6,0,0" />
        <TextBlock Text="{Binding Error}" Style="{StaticResource ErrorText}"
                   Visibility="{Binding Error, Converter={StaticResource VisibleWhenSet}}" />

        <!-- Mode -->
        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <RadioButton Content="Password" IsChecked="{Binding UsePassphrase, Converter={StaticResource InverseBool}}" Margin="0,0,16,0" />
            <RadioButton Content="Passphrase" IsChecked="{Binding UsePassphrase}" />
        </StackPanel>

        <!-- Password options -->
        <StackPanel Visibility="{Binding UsePassphrase, Converter={StaticResource InverseBoolToVisibility}}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding Length, StringFormat=Length: {0}}" />
            <Slider Minimum="8" Maximum="64" Value="{Binding Length}" IsSnapToTickEnabled="True" TickFrequency="1" />
            <WrapPanel Margin="0,8,0,0">
                <CheckBox Content="a–z" IsChecked="{Binding Lowercase}" Margin="0,0,16,0" />
                <CheckBox Content="A–Z" IsChecked="{Binding Uppercase}" Margin="0,0,16,0" />
                <CheckBox Content="0–9" IsChecked="{Binding Digits}" Margin="0,0,16,0" />
                <CheckBox Content="!@#$" IsChecked="{Binding Symbols}" />
            </WrapPanel>
            <CheckBox Content="Avoid look-alike characters (I l 1 O 0 o)" IsChecked="{Binding ExcludeAmbiguous}" Margin="0,4,0,0" />
        </StackPanel>

        <!-- Passphrase options -->
        <StackPanel Visibility="{Binding UsePassphrase, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource FieldLabel}" Text="{Binding WordCount, StringFormat=Words: {0}}" />
            <Slider Minimum="3" Maximum="12" Value="{Binding WordCount}" IsSnapToTickEnabled="True" TickFrequency="1" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="Separator" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Text="{Binding Separator, UpdateSourceTrigger=PropertyChanged}" Width="48" MaxLength="3" />
            </StackPanel>
            <WrapPanel Margin="0,8,0,0">
                <CheckBox Content="Capitalize words" IsChecked="{Binding Capitalize}" Margin="0,0,16,0" />
                <CheckBox Content="Add a number" IsChecked="{Binding IncludeNumber}" />
            </WrapPanel>
        </StackPanel>

        <!-- Actions -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Content="Close" IsCancel="True" Margin="0,0,8,0" Padding="16,6" />
            <Button Content="Copy" Command="{Binding CopyCommand}" Margin="0,0,8,0" Padding="16,6" />
            <Button Content="Use" Command="{Binding UseCommand}" IsDefault="True" Style="{StaticResource AccentButtonStyle}" Padding="16,6"
                    Visibility="{Binding AllowUse, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </StackPanel>
</Window>
