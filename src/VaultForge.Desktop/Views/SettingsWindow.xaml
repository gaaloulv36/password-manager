<Window x:Class="VaultForge.Desktop.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/VaultForge;component/Assets/VaultForge.ico"
        FontFamily="{StaticResource BodyFont}"
        Background="{StaticResource CharcoalBrush}"
        Title="Settings · VaultForge"
        Width="600" Height="720" MinWidth="480" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">

            <!-- Security -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Locking" Style="{StaticResource SectionTitle}" />

                    <TextBlock Text="Lock after this long without keyboard or mouse use" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding AutoLockChoices}" SelectedItem="{Binding AutoLockMinutes}" DisplayMemberPath="Label"
                              HorizontalAlignment="Left" MinWidth="180" />
                    <TextBlock Text="The vault also locks when you lock Windows (Win+L) or the PC goes to sleep." Style="{StaticResource Hint}" />

                    <CheckBox Content="Lock when the window is minimized" IsChecked="{Binding LockOnMinimize}" Margin="0,12,0,0" />
                    <CheckBox Content="Keep running in the notification area when the window is closed" IsChecked="{Binding CloseToTray}" Margin="0,4,0,0" />

                    <CheckBox IsChecked="{Binding ProtectFromScreenCapture}" Margin="0,4,0,0">
                        <TextBlock TextWrapping="Wrap"
                                   Text="Hide VaultForge from screenshots and screen sharing (Teams, Zoom, Discord…)" />
                    </CheckBox>

                    <TextBlock Text="Clear copied passwords from the clipboard after" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding ClipboardChoices}" SelectedItem="{Binding ClipboardSeconds}" DisplayMemberPath="Label"
                              HorizontalAlignment="Left" MinWidth="180" />
                </StackPanel>
            </Border>

            <!-- Windows Hello -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Windows Hello" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Unlock with your face, fingerprint or PIN on this PC. Your master password keeps working, and is still needed on other PCs." />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                               Text="Windows Hello isn't set up on this PC. Set it up in Windows Settings → Accounts → Sign-in options, then reopen Settings."
                               Visibility="{Binding IsHelloAvailable, Converter={StaticResource InverseBoolToVisibility}}" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0"
                                Visibility="{Binding IsHelloAvailable, Converter={StaticResource BoolToVisibility}}">
                        <Button Content="Turn on Windows Hello" Command="{Binding EnableHelloCommand}" Padding="16,6"
                                Visibility="{Binding IsHelloEnabled, Converter={StaticResource InverseBoolToVisibility}}" />
                        <Button Content="Turn off Windows Hello" Command="{Binding DisableHelloCommand}" Padding="16,6"
                                Visibility="{Binding IsHelloEnabled, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding HelloMessage}" Style="{StaticResource Hint}"
                               Visibility="{Binding HelloMessage, Converter={StaticResource VisibleWhenSet}}" />
                </StackPanel>
            </Border>

            <!-- Master password -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Change master password" Style="{StaticResource SectionTitle}" />

                    <TextBlock Text="Current master password" Style="{StaticResource FieldLabel}" />
                    <PasswordBox x:Name="CurrentInput" PasswordChanged="OnCurrentChanged" />
                    <TextBlock Text="New master password" Style="{StaticResource FieldLabel}" />
                    <PasswordBox x:Name="NewInput" PasswordChanged="OnNewChanged" />
                    <TextBlock Text="{Binding NewPasswordStrength}" Style="{StaticResource Hint}" />
                    <TextBlock Text="Confirm new master password" Style="{StaticResource FieldLabel}" />
                    <PasswordBox x:Name="ConfirmInput" PasswordChanged="OnConfirmChanged" />

                    <TextBlock Text="{Binding PasswordMessage}" TextWrapping="Wrap" Margin="0,12,0,0"
                               Visibility="{Binding PasswordMessage, Converter={StaticResource VisibleWhenSet}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PasswordMessageIsError}" Value="True">
                                        <Setter Property="Foreground" Value="#D13438" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Button Content="Change master password" Command="{Binding ChangePasswordCommand}"
                            HorizontalAlignment="Left" Margin="0,16,0,0" Padding="16,6" />
                </StackPanel>
            </Border>

            <!-- Browser extension -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Browser extension" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Browsers connected to this PC can fill and save logins while the vault is unlocked. To connect one, click the VaultForge icon in the browser's toolbar." />
                    <TextBlock Text="No browsers connected yet." Style="{StaticResource Hint}" Margin="0,12,0,0"
                               Visibility="{Binding ConnectedBrowsers.Count, Converter={StaticResource VisibleWhenNull}}" />
                    <ItemsControl ItemsSource="{Binding ConnectedBrowsers}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,4">
                                    <Button DockPanel.Dock="Right" Content="Disconnect"
                                            Command="{Binding DataContext.DisconnectBrowserCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding BrowserName}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                        <TextBlock Text="{Binding PairedAt, Converter={StaticResource LocalTime}, StringFormat=Connected {0:d}}" Style="{StaticResource Hint}" Margin="0" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Backup & export -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Backup &amp; export" Style="{StaticResource SectionTitle}" />

                    <TextBlock Style="{StaticResource Hint}"
                               Text="A backup of the encrypted vault is made automatically once a day when you unlock (the last 14 are kept, outside your sync folder)." />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="Save a backup…" Command="{Binding BackupNowCommand}" Margin="0,0,8,0" Padding="16,6" />
                        <Button Content="Open backups folder" Command="{Binding OpenBackupFolderCommand}" Padding="16,6" />
                    </StackPanel>

                    <TextBlock Text="Export to CSV (unencrypted)" Style="{StaticResource FieldLabel}" Margin="0,24,0,4" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                               Text="Only for moving to another password manager. Enter your master password to confirm." />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="ExportInput" PasswordChanged="OnExportChanged" />
                        <Button Grid.Column="1" Content="Export…" Command="{Binding ExportCsvCommand}" Margin="8,0,0,0" Padding="16,6" />
                    </Grid>
                    <TextBlock Text="{Binding ExportMessage}" Style="{StaticResource Hint}"
                               Visibility="{Binding ExportMessage, Converter={StaticResource VisibleWhenSet}}" />
                </StackPanel>
            </Border>

            <!-- App & updates -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="App &amp; updates" Style="{StaticResource SectionTitle}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="User guide" Command="{Binding OpenUserGuideCommand}"
                                ToolTip="Step-by-step help: setup, browser extension, import, sync, backups, troubleshooting" />
                        <TextBlock Text="{Binding Version, StringFormat=Version {0}}" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                    </DockPanel>

                    <StackPanel Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}">
                        <CheckBox Content="Start with Windows (in the notification area)" IsChecked="{Binding StartWithWindows}" Margin="0,12,0,0" />
                        <CheckBox Content="Download updates automatically (checks every 6 hours)" IsChecked="{Binding CheckForUpdates}" Margin="0,4,0,0" />
                        <CheckBox IsChecked="{Binding InstallUpdatesWhenAway}" Margin="0,4,0,0">
                            <TextBlock TextWrapping="Wrap"
                                       Text="Install downloaded updates by themselves while the vault is locked and I've been away for 10 minutes" />
                        </CheckBox>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Check for updates" Command="{Binding CheckForUpdateNowCommand}" Margin="0,0,8,0" Padding="16,6" />
                            <Button Content="Restart to update" Command="{Binding RestartToUpdateCommand}" Style="{StaticResource AccentButtonStyle}" Padding="16,6"
                                    Visibility="{Binding IsUpdateReady, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource Hint}"
                                   Visibility="{Binding UpdateStatus, Converter={StaticResource VisibleWhenSet}}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                               Text="This copy runs from the source folder. Install VaultForge to get automatic updates and start with Windows."
                               Visibility="{Binding IsInstalled, Converter={StaticResource InverseBoolToVisibility}}" />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding VaultPath, StringFormat=Vault file: {0}}" Style="{StaticResource Hint}" Margin="0,16,0,0" />
        </StackPanel>
    </ScrollViewer>
</Window>
