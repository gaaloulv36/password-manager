<Window x:Class="VaultForge.Desktop.Views.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/VaultForge;component/Assets/VaultForge.ico"
        FontFamily="{StaticResource BodyFont}"
        Background="{StaticResource CharcoalBrush}"
        Title="{Binding FileName, StringFormat=Import from {0} · VaultForge}"
        Width="760" Height="560" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Check before importing" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,8,0,12" />
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="None" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="2*" />
                <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="2*" />
                <DataGridTextColumn Header="Website" Binding="{Binding Site}" Width="2*" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Margin="0,16,0,0">
            <CheckBox IsChecked="{Binding IncludeDuplicates}" Content="Also import entries that are already in my vault (creates duplicates)"
                      Visibility="{Binding DuplicateCount, Converter={StaticResource VisibleWhenSet}}" />
            <CheckBox IsChecked="{Binding DeleteFileAfterImport}" Margin="0,8,0,0">
                <TextBlock TextWrapping="Wrap">
                    <Run Text="Delete" /> <Run Text="{Binding FileName, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text="after importing (recommended — it contains all your passwords in plain text)" />
                </TextBlock>
            </CheckBox>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" Padding="16,6" />
                <Button Content="{Binding ImportButtonText}" Command="{Binding ImportCommand}" IsDefault="True"
                        Style="{StaticResource AccentButtonStyle}" Padding="16,6" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
