<UserControl x:Class="VaultForge.Desktop.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border Style="{StaticResource Card}" Width="460" Padding="32" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
                <Image Source="{StaticResource VaultForgeLogo}" Width="72" Height="72" HorizontalAlignment="Center"
                       AutomationProperties.Name="VaultForge logo" />
                <TextBlock Style="{StaticResource Wordmark}" FontSize="32" HorizontalAlignment="Center" Margin="0,14,0,0">
                    <Run Text="Vault" FontWeight="Medium" /><Run Text="Forge" FontWeight="Bold" />
                </TextBlock>
                <TextBlock Text="by Forge Studio" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,2,0,16" />
                <TextBlock Text="Your passwords in one encrypted file. Only your master password opens it."
                           TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,24" />

                <Button Content="Create a new vault" Command="{Binding CreateVaultCommand}"
                        Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Padding="12,10" FontWeight="SemiBold" />
                <Button Content="Open an existing vault…" Command="{Binding OpenVaultCommand}"
                        HorizontalAlignment="Stretch" Padding="12,10" Margin="0,8,0,0" />

                <TextBlock Text="Using the vault on another PC? Choose “Open an existing vault” and pick the file in your synced folder."
                           Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{StaticResource MutedBrush}" Margin="0,16,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
