<UserControl x:Class="VaultForge.Desktop.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border Style="{StaticResource Card}" Width="440" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel>
                <TextBlock Text="🔐" FontSize="40" HorizontalAlignment="Center" />
                <TextBlock Text="Password Manager" Style="{StaticResource TitleTextBlockStyle}"
                           HorizontalAlignment="Center" Margin="0,8,0,4" />
                <TextBlock Text="Your passwords in one encrypted file that only your master password can open."
                           Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" TextAlignment="Center"
                           Opacity="0.8" Margin="0,0,0,24" />

                <Button Content="Create a new vault" Command="{Binding CreateVaultCommand}"
                        Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Padding="12,8" />
                <Button Content="Open an existing vault…" Command="{Binding OpenVaultCommand}"
                        HorizontalAlignment="Stretch" Padding="12,8" Margin="0,8,0,0" />

                <TextBlock Text="Using the vault on another PC? Choose “Open an existing vault” and pick the file in your synced folder."
                           Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" TextAlignment="Center"
                           Opacity="0.65" Margin="0,16,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
