<Window x:Class="VaultForge.Desktop.Views.HealthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="pack://application:,,,/VaultForge;component/Assets/VaultForge.ico"
        Title="Password health"
        Width="720" Height="680" MinWidth="520" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="Count" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CountLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0.7" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Score + counts -->
        <Border Style="{StaticResource Card}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Margin="0,0,24,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ScoreText}" FontSize="44" FontWeight="SemiBold" HorizontalAlignment="Center"
                               AutomationProperties.Name="Health score" />
                    <TextBlock Text="out of 100" Style="{StaticResource CountLabel}" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                    <UniformGrid Columns="4" Margin="0,12,0,0">
                        <StackPanel><TextBlock Text="{Binding Report.Breached}" Style="{StaticResource Count}" /><TextBlock Text="breached" Style="{StaticResource CountLabel}" /></StackPanel>
                        <StackPanel><TextBlock Text="{Binding Report.Reused}" Style="{StaticResource Count}" /><TextBlock Text="reused" Style="{StaticResource CountLabel}" /></StackPanel>
                        <StackPanel><TextBlock Text="{Binding Report.Weak}" Style="{StaticResource Count}" /><TextBlock Text="weak" Style="{StaticResource CountLabel}" /></StackPanel>
                        <StackPanel><TextBlock Text="{Binding Report.Old}" Style="{StaticResource Count}" /><TextBlock Text="over a year old" Style="{StaticResource CountLabel}" /></StackPanel>
                    </UniformGrid>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Breach check -->
        <StackPanel Grid.Row="1" Margin="0,16,0,8">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Check for breaches" Command="{Binding CheckBreachesCommand}"
                        Style="{StaticResource AccentButtonStyle}" Padding="16,6" VerticalAlignment="Top" />
                <TextBlock TextWrapping="Wrap" Opacity="0.8" Margin="0,0,16,0"
                           Text="Checks your passwords against Have I Been Pwned. Only the first 5 characters of each password's SHA-1 fingerprint are sent — never the password or its full fingerprint." />
            </DockPanel>
            <TextBlock Text="{Binding BreachStatus}" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,8,0,0" TextWrapping="Wrap"
                       Visibility="{Binding BreachStatus, Converter={StaticResource VisibleWhenSet}}" />
            <CheckBox Content="Show logins without issues too" IsChecked="{Binding ShowAll}" Margin="0,12,0,0" />
        </StackPanel>

        <!-- Logins -->
        <ListBox Grid.Row="2" ItemsSource="{Binding Rows}" HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Logins">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Open website" Margin="0,0,8,0"
                                    Command="{Binding DataContext.OpenWebsiteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                    Visibility="{Binding Website, Converter={StaticResource VisibleWhenSet}}" />
                            <Button Content="Edit"
                                    Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Username}" Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.7" />
                            <ItemsControl ItemsSource="{Binding Issues}" Margin="0,4,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat=• {0}}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="No issues" Opacity="0.6" Margin="0,4,0,0"
                                       Visibility="{Binding Issues.Count, Converter={StaticResource VisibleWhenNull}}" />
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Window>
