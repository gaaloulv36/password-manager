<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- EFF large wordlist (CC BY 3.0): https://www.eff.org/dice -->
    <EmbeddedResource Include="Generators\Resources\eff_large_wordlist.txt" LogicalName="VaultForge.Core.EffWordlist" />
    <!-- 10k most common passwords, SecLists (MIT): https://github.com/danielmiessler/SecLists -->
    <EmbeddedResource Include="Generators\Resources\common-passwords.txt" LogicalName="VaultForge.Core.CommonPasswords" />
  </ItemGroup>

</Project>
