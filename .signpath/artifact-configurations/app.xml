<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "app": the published app folder (uploaded as a zip by the release workflow).
     Paste into the SignPath project (Artifact configurations) with slug "app". -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="VaultForge.exe"><authenticode-sign /></pe-file>
    <pe-file path="VaultForge.NativeHost.exe"><authenticode-sign /></pe-file>
    <pe-file-set>
      <include path="VaultForge.*.dll" />
      <for-each><authenticode-sign /></for-each>
    </pe-file-set>
  </zip-file>
</artifact-configuration>
